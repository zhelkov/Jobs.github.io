		<td><strong>fathom</strong></td>
		<td>осознать</td>
	</tr>
	<tr>
		<td><strong>the lifeblood of the company</strong></td>
		<td>кровь компании</td>
	</tr>
	<tr>
		<td><strong>spawned</strong></td>
		<td>рождали</td>
	</tr>
