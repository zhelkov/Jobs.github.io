	<tr>
		<td><strong>shuffle</strong></td>
		<td>перемешивание</td>
	</tr>
	<tr>
		<td><strong>obsessed with</strong></td>
		<td>зациклены на</td>
	</tr>
	<tr>
		<td><strong>navigate the songs</strong></td>
		<td>искать песни</td>
	</tr>
	<tr>
		<td><strong>Embrace uncertainty</strong></td>
