	<tr>
		<td><strong>prickliness</strong></td>
		<td>колючесть, обидчивость</td>
	</tr>
	<tr>
		<td><strong>stepped aside</strong></td>
		<td>отошла от дел</td>
	</tr>
	<tr>
		<td><strong>step in</strong></td>
		<td>вмешаться</td>
	</tr>
	<tr>
		<td><strong>deliver</strong></td>
		<td>выполнить обещанное</td>
	</tr>
	<tr>
		<td><strong>fear factor</strong></td>
